# =============================================================================
# nrzube — BusyBox fragment
#
# Buildroot's default BusyBox configuration already covers the essentials
# (ash, mount, switch_root, mdev, modprobe, sha256sum, blkid, wget, getty...).
# What is missing is added here, and the options used by the initramfs and
# the startup scripts are pinned.
# =============================================================================

# stat is used by the slot scripts (size/permission checks).
CONFIG_STAT=y

# blkid: identification of the SD card partitions.
CONFIG_FEATURE_VOLUMEID_EXT=y
CONFIG_FEATURE_VOLUMEID_EXT2=y
CONFIG_FEATURE_VOLUMEID_EXT4=y
CONFIG_FEATURE_VOLUMEID_SQUASHFS=y

# mount: the -o move/rbind options used by the initramfs to switch the root
# and to move /proc, /sys and /dev into the new rootfs.
CONFIG_FEATURE_MOUNT_HELP=y
CONFIG_FEATURE_MOUNT_FSTAB=y
CONFIG_FEATURE_MOUNT_MOVE=y
CONFIG_FEATURE_MOUNT_BIND=y

# awk/sed: manipulation of the slot state files.
CONFIG_FEATURE_SED_EVEN_SIZES=y
CONFIG_FEATURE_SORT_OPTIMIZE=y

# dmesg: boot diagnostics (access to /dev/kmsg).
CONFIG_FEATURE_DMESG_OUTPUT=y

# ps: diagnostics of the s6 supervision tree.
CONFIG_FEATURE_SHOW_OTHERS=y
