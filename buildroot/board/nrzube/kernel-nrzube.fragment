# =============================================================================
# nrzube — kernel fragment for the RPi 5 (base: bcm2712_defconfig, 6.18.39)
#
# bcm2712_defconfig builds everything the boot path needs as a module
# (SQUASHFS, OVERLAY_FS, IPV6, NF_TABLES, NF_CONNTRACK, BRIDGE, VETH,
# BRIDGE_NETFILTER). The initramfs has to mount p4 (ext4), the slot squashfs
# and the /etc overlay WITHOUT loading a single module: those filesystems are
# therefore built in (=y).
#
# Note: an unknown symbol in a fragment is simply ignored by merge_config.pl
# — the fragment stays tolerant to kernel evolution.
# =============================================================================

# --- Filesystems required by the initramfs (no module at boot time) ----------
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_REDIRECT_ALLOW=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- IPv6 ---------------------------------------------------------------------
# SLAAC (dhcpcd handles the RA in user space, but the kernel must be able to
# route IPv6) + IPv6 forwarding required by kube-proxy and the CNIs.
CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SUBTREES=y
CONFIG_IPV6_ADDR_CONF=y
CONFIG_IPV6_OPTIMISTIC_ROUTER=y

# --- Networking: bridge, veth, netfilter -------------------------------------
# The "bridge" CNI plugin and Cilium need bridge/veth; kube-proxy needs
# netfilter. Everything is built in to avoid module loading in the critical
# path of the network start-up.
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VLAN_8021Q=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y

# --- Netfilter: conntrack, nftables, iptables --------------------------------
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_ZONES=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_NAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_QUEUE=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --- cgroup v2 (containerd 2.x + kubelet) -----------------------------------
# There is no CONFIG_CGROUP_V2 symbol: the unified hierarchy is provided by
# CONFIG_CGROUPS. It is enabled explicitly anyway, together with the
# controllers required by kubelet and containerd.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# --- seccomp: runc depends on it ---------------------------------------------
# CONFIG_SECCOMP does not show up in bcm2712_defconfig (it defaults to y via
# HAVE_ARCH_SECCOMP). It is forced explicitly here: runc fails without it.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- eBPF (Cilium, kubelet, containerd) --------------------------------------
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_LSM=y
CONFIG_NET_CLS_BPF=y

# --- HDMI console (framebuffer) ----------------------------------------------
# The DRM stack is built in: the initramfs has no module to load, and the
# console on the screen has to be available as soon as the kernel starts.
# This is also what makes the video output usable on the node (plan §2.3).
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
# DRM_VC4 depends on the Raspberry Pi firmware driver, on the clock and on
# the ALSA SoC layer (the HDMI audio helpers are selected by the driver).
CONFIG_RASPBERRYPI_FIRMWARE=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_DRM_VC4=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CMA=y

# --- Miscellaneous ------------------------------------------------------------
# The dhcpcd SLAAC client and the bridge CNI need /proc and netlink; the
# overlay mount requires CONFIG_OVERLAY_FS (above).
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_POSIX_MQUEUE=y
