# =============================================================================
# nrzube — DHCP hook: NTP servers (option 42) → chrony sources.
#
# This script is *sourced* by dhcpcd-run-hooks: it must not use "exit".
#
# dhcpcd exports option 42 as new_ntp_servers (a space separated list of
# addresses). The servers are written as a chrony .sources file under
# /run/chrony (the sourcedir of /etc/chrony.conf) and chronyd is asked to
# reload its sources (best effort: chronyd may not be up yet — it reads the
# sourcedir at startup anyway). See plan §5.7.
# =============================================================================

ntp_servers="${new_ntp_servers:-}"

if [ -n "$ntp_servers" ]; then
	mkdir -p /run/chrony
	umask 022
	tmp=/run/chrony/.dhcp.sources.tmp.$$
	{
		echo "# generated by the nrzube dhcpcd hook from DHCP option 42"
		for server in $ntp_servers; do
			echo "server $server iburst"
		done
	} > "$tmp" && mv "$tmp" /run/chrony/dhcp.sources
	chronyc -n reload sources >/dev/null 2>&1 || true
	echo "nrzube[dhcpcd]: NTP servers received (option 42)"
fi
